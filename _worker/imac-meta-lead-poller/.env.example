# 노블홍 아이맥 Meta 리드 폴러 — .env 예시
# 실제 파일은 아이맥의 /Users/pola/noblehong-meta-lead-poller/.env 에만 둔다 (git 커밋 금지)

# Meta 시스템사용자 토큰 (leads_retrieval 필요). 프로젝트 .env 의 META_SYSTEM_USER_TOKEN 과 동일값
META_SYSTEM_USER_TOKEN=

# 조회할 리드폼 ID (콤마 구분)
#   1304445771796402 = 260515_접수양식_V2 (현재 유입 전량)
#   1658915391822063 = 260515_접수양식    (구버전, 2026-05-18 이후 유입 없음)
META_LEAD_FORM_IDS=1304445771796402,1658915391822063

# Make 시나리오를 끈 시각(ISO). 이 시각 이전 리드는 Make가 이미 처리했으므로 절대 다시 안 긁는다.
# 전환 당일 Make OFF 하고 그 시각을 여기에 적을 것.
META_LEAD_CUTOVER_AT=

# 워커 엔드포인트 + 인증 시크릿 (프로젝트 .env 의 META_LEAD_SECRET 과 동일값)
LEAD_WEBHOOK_URL=https://noblehong-api.noblehong0.workers.dev/api/lead/meta
LEAD_WEBHOOK_SECRET=
LEAD_HEARTBEAT_URL=https://noblehong-api.noblehong0.workers.dev/api/lead/meta/heartbeat

# 인프라봇 (@bas263thBot / 채널 -1004487628453) — 접수체크·실패 알림
HEALTH_TELEGRAM_BOT_TOKEN=
HEALTH_TELEGRAM_CHAT_ID=-1004487628453

# 선택 — 기본값으로 충분
# META_GRAPH_VERSION=v22.0
# META_LEAD_LOOKBACK_HOURS=48
# META_LEAD_OVERLAP_HOURS=48
# META_LEAD_MAX_PAGES=10
# 신규 리드가 없는 시간대에 인프라봇에 생존신고를 보내는 간격 (기본 6시간)
# META_LEAD_HEALTH_QUIET_HOURS=6
# 1 이면 매 실행(1시간)마다 무조건 인프라봇에 보고 — 하루 24통
# META_LEAD_HEALTH_ALWAYS=0
# 1 이면 조회만 하고 전송·알림 안 함 (권한 점검용)
# META_LEAD_DRY_RUN=0
